{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:maven-groupid",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:apm"
  ],
  "packageRules": [
    {
      "description": [
        "These artifacts are modules of this repository, and the release plugin sets their versions, so Renovate has nothing to update. Many of them are not on Maven Central, and looking them up there can abort the run with a rate limit error."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.qubership.nifi:*", "org.qubership.nifi.plugins:*"],
      "enabled": false
    },
    {
      "description": [
        "This BOM is not on Maven Central, and Renovate has no credentials for GitHub Packages, so the lookup cannot succeed. The BOM is upgraded by hand together with the Quarkus platform."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.netcracker.cloud:core-quarkus-external-bom"],
      "enabled": false
    },
    {
      "description": [
        "The repositories in pom.xml include a URL that is not a Maven repository, a snapshots-only repository, and GitHub Packages, which needs credentials Renovate lacks. Third-party artifacts are looked up in Maven Central only."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["!/^com\\.netcracker[.:]/", "!/^org\\.qubership[.:]/"],
      "registryUrls": ["https://repo.maven.apache.org/maven2"]
    },
    {
      "description": [
        "registry.example.com/flow-diff-cli:X.Y.Z is a placeholder in dev/gitlab-ci-cd-flow-diff/.gitlab-ci.yml, and that host does not exist."
      ],
      "matchManagers": ["gitlabci"],
      "matchPackageNames": ["registry.example.com/**"],
      "enabled": false
    },
    {
      "description": [
        "The autotests build local-nifi:test locally, so no registry has this image."
      ],
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["local-nifi"],
      "enabled": false
    },
    {
      "description": [
        "NiFi provides these at runtime, so the versions must match the NiFi distribution and move only with it."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "redis.clients:jedis",
        "org.springframework.data:spring-data-redis"
      ],
      "enabled": false
    },
    {
      "description": [
        "NiFi upgrades may require adaptation and are done by hand. The NAR plugin versions independently, so it stays enabled."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "org.apache.nifi:*",
        "!org.apache.nifi:nifi-nar-maven-plugin"
      ],
      "enabled": false
    },
    {
      "description": [
        "Each qubership-nifi-h2-deps-* module pins the H2 version it is named after, so that version must not move."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.h2database:h2"],
      "matchFileNames": ["qubership-nifi-deps/**"],
      "enabled": false
    },
    {
      "description": [
        "Renovate does not regenerate the --hash values in requirements-test.txt, so a bump would fail the python-tests job."
      ],
      "matchManagers": ["pip_requirements"],
      "enabled": false
    },
    {
      "description": [
        "Each Dockerfile pins its base image through separate version and digest ARGs, which Renovate cannot update as one dependency."
      ],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "description": [
        "Certificate generation needs the NiFi 1.x tls-toolkit, and dev/tls/docker-compose.yml hardcodes the 1.28.1 path."
      ],
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["apache/nifi-toolkit"],
      "enabled": false
    },
    {
      "description": [
        "The autotest compose files track the latest published nifi-registry image on purpose, so the tag must stay floating and undigested."
      ],
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/netcracker/qubership-nifi-registry"],
      "matchFileNames": [".github/docker/**"],
      "enabled": false
    },
    {
      "description": [
        "Spring Boot, Spring Framework, and Spring Cloud majors break APIs, so they are upgraded by hand after dashboard approval."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.springframework*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Each Spring Boot minor needs a new Spring Cloud release train, which Renovate treats as a major, so Boot minors wait for approval too."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.springframework.boot:*"],
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Quarkus majors break extensions and configuration, so they are upgraded by hand after dashboard approval."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.quarkus*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Jackson 3 changes package names and group IDs, so Jackson majors are upgraded by hand."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.fasterxml.jackson*", "tools.jackson*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "SLF4J majors change how bindings are found, so they must move together with the logging backend."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.slf4j:*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Oracle JDBC majors follow Oracle Database releases and change the supported server versions; ojdbc8 and orai18n move together."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.oracle.database*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "The processors call the json-path and json-schema-validator APIs directly, and majors of both libraries change those APIs."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.jayway.jsonpath:*", "com.networknt:json-schema-validator"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Testcontainers 2 renames artifacts and JUnit 6 raises the Java baseline, so test framework majors are upgraded by hand."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.testcontainers:*", "com.redis:testcontainers-redis", "org.junit*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "HikariCP, Guava, and JGit majors change APIs or the minimum Java version of the NARs and tools that bundle them."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.zaxxer:HikariCP", "com.google.guava:*", "org.eclipse.jgit:*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Guava publishes each release in an -android and a -jre flavor, and the NARs and tools run on a full JRE, so only -jre versions are allowed."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.google.guava:guava"],
      "allowedVersions": "/-jre$/"
    },
    {
      "description": [
        "The Maven API that the plugins compile against must match the Maven 3 runtime that executes them."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["org.apache.maven:*", "org.apache.maven.plugin-tools:*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Code quality tool majors add or change rules and can fail the build, so their findings are fixed by hand during the upgrade."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "com.puppycrawl.tools:checkstyle",
        "com.github.spotbugs:*",
        "org.sonarsource.scanner.maven:*",
        "net.sourceforge.pmd:*"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Micrometer, Netty, and Logback majors change runtime APIs used by the NiFi bundles and consul modules."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.micrometer:*", "io.netty:*", "ch.qos.logback:*"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "micrometer-registry-prometheus 1.13 moves to Prometheus client 1.x, which changes metric names and the registry API, so it stays on 1.12.x until the migration is done by hand."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.micrometer:micrometer-registry-prometheus"],
      "allowedVersions": "<1.13"
    },
    {
      "description": [
        "Quarkus platform upgrades move together with core-quarkus-external-bom and are done by hand, so only 3.33.3.x builds are allowed."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.quarkus.platform:*"],
      "allowedVersions": "/^3\\.33\\.3\\./"
    },
    {
      "description": [
        "core-quarkus-external-bom 1.0.9 requires Netty 4.1.x, so netty-bom stays on 4.1.x until that BOM moves to a newer Netty."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["io.netty:netty-bom"],
      "allowedVersions": "/^4\\.1\\./"
    },
    {
      "description": [
        "Majors of third-party images in the test compose files can change data formats and configuration, so they are upgraded by hand."
      ],
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "description": [
      "Repeat the rules above, because a disabling packageRule does not reliably stop a vulnerability alert PR."
    ],
    "packageRules": [
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["org.qubership.nifi:*", "org.qubership.nifi.plugins:*"],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["com.netcracker.cloud:core-quarkus-external-bom"],
        "enabled": false
      },
      {
        "matchManagers": ["gitlabci"],
        "matchPackageNames": ["registry.example.com/**"],
        "enabled": false
      },
      {
        "matchManagers": ["docker-compose"],
        "matchPackageNames": ["local-nifi"],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": [
          "redis.clients:jedis",
          "org.springframework.data:spring-data-redis"
        ],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": [
          "org.apache.nifi:*",
          "!org.apache.nifi:nifi-nar-maven-plugin"
        ],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["com.h2database:h2"],
        "matchFileNames": ["qubership-nifi-deps/**"],
        "enabled": false
      },
      {
        "matchManagers": ["pip_requirements"],
        "enabled": false
      },
      {
        "matchManagers": ["dockerfile"],
        "enabled": false
      },
      {
        "matchManagers": ["docker-compose"],
        "matchPackageNames": ["apache/nifi-toolkit"],
        "enabled": false
      },
      {
        "matchManagers": ["docker-compose"],
        "matchPackageNames": ["ghcr.io/netcracker/qubership-nifi-registry"],
        "matchFileNames": [".github/docker/**"],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["com.google.guava:guava"],
        "allowedVersions": "/-jre$/"
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["io.micrometer:micrometer-registry-prometheus"],
        "allowedVersions": "<1.13"
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["io.quarkus.platform:*"],
        "allowedVersions": "/^3\\.33\\.3\\./"
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["io.netty:netty-bom"],
        "allowedVersions": "/^4\\.1\\./"
      }
    ]
  }
}
