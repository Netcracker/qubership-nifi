{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:maven-groupid",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:apm"
  ],
  "packageRules": [
    {
      "description": [
        "NiFi provides these at runtime, so the versions must match the NiFi distribution and move only with it."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "redis.clients:jedis",
        "org.springframework.data:spring-data-redis"
      ],
      "enabled": false
    },
    {
      "description": [
        "NiFi upgrades may require adaptation and are done by hand. The NAR plugin versions independently, so it stays enabled."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "org.apache.nifi:*",
        "!org.apache.nifi:nifi-nar-maven-plugin"
      ],
      "enabled": false
    },
    {
      "description": [
        "Each qubership-nifi-h2-deps-* module pins the H2 version it is named after, so that version must not move."
      ],
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.h2database:h2"],
      "matchFileNames": ["qubership-nifi-deps/**"],
      "enabled": false
    },
    {
      "description": [
        "Renovate does not regenerate the --hash values in requirements-test.txt, so a bump would fail the python-tests job."
      ],
      "matchManagers": ["pip_requirements"],
      "enabled": false
    },
    {
      "description": [
        "Each Dockerfile pins its base image through separate version and digest ARGs, which Renovate cannot update as one dependency."
      ],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "description": [
        "Certificate generation needs the NiFi 1.x tls-toolkit, and dev/tls/docker-compose.yml hardcodes the 1.28.1 path."
      ],
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["apache/nifi-toolkit"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "description": [
      "Repeat the rules above, because a disabling packageRule does not reliably stop a vulnerability alert PR."
    ],
    "packageRules": [
      {
        "matchManagers": ["maven"],
        "matchPackageNames": [
          "redis.clients:jedis",
          "org.springframework.data:spring-data-redis"
        ],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": [
          "org.apache.nifi:*",
          "!org.apache.nifi:nifi-nar-maven-plugin"
        ],
        "enabled": false
      },
      {
        "matchManagers": ["maven"],
        "matchPackageNames": ["com.h2database:h2"],
        "matchFileNames": ["qubership-nifi-deps/**"],
        "enabled": false
      },
      {
        "matchManagers": ["pip_requirements"],
        "enabled": false
      },
      {
        "matchManagers": ["dockerfile"],
        "enabled": false
      },
      {
        "matchManagers": ["docker-compose"],
        "matchPackageNames": ["apache/nifi-toolkit"],
        "enabled": false
      }
    ]
  }
}
