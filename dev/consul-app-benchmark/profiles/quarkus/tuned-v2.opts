# Second tuned candidate for the Quarkus app: tuned-v1 with smaller limits.
# tuned-v1 peaks: live heap after GC 8 MiB, metaspace 24.0 MiB, code cache 4.8 MiB.
-XX:+UseSerialGC
-Xms16m
-Xmx24m
-XX:MaxMetaspaceSize=32m
-XX:CompressedClassSpaceSize=16m
-XX:TieredStopAtLevel=1
-XX:CICompilerCount=1
-XX:ReservedCodeCacheSize=12m
-Xss512k
-XX:MaxDirectMemorySize=16m
-XX:+UseCompactObjectHeaders
