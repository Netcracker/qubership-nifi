# Defaults for the provenance-repo-full scenario. A variable already set in the environment wins.
# Size of the tmpfs that holds the provenance repository, in docker tmpfs syntax.
PROVENANCE_REPO_SIZE="${PROVENANCE_REPO_SIZE:-256m}"
# Value of nifi.provenance.repository.max.storage.size, in NiFi data size syntax. The default is larger than the tmpfs.
PROVENANCE_MAX_STORAGE_SIZE="${PROVENANCE_MAX_STORAGE_SIZE:-512 MB}"
# Seconds the flow keeps running after the first write error, so that the errors repeat and reach bulletins.
AFTER_FULL_SECONDS="${AFTER_FULL_SECONDS:-60}"
