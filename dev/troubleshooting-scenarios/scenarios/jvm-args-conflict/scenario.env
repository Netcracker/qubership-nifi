# Defaults for the jvm-args-conflict scenario. A variable already set in the environment wins.
# Value of NIFI_ADDITIONAL_JVM_ARGS on the second start.
JVM_ARGS_ADDITIONAL="${JVM_ARGS_ADDITIONAL:--XX:+UseG1GC}"
# Value of X_JAVA_ARGS on the second start. It selects a garbage collector other than JVM_ARGS_ADDITIONAL.
JVM_ARGS_X_JAVA="${JVM_ARGS_X_JAVA:--XX:+UseParallelGC}"
